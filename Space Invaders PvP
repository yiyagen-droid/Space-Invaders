import pygame
pygame.init()

WIDTH = 1400
HEIGHT = 800
TITLE = "Space Invaders"

screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption(TITLE)

space_bg = pygame.image.load("pygame projects/images/space2.png")
space_bg = pygame.transform.scale(space_bg, (1600, 900))
yellow_ship = pygame.image.load("pygame projects/images/spaceinvader_yellow.png")
red_ship = pygame.image.load("pygame projects/images/spaceinvader_red.png")

angle = 0

bullets1 = []
bullets2 = []

def shoot1():
    for bullet1 in bullets1:
        pygame.draw.rect(screen, "white", bullet1)
        bullet1.x += 5

def shoot2():
    for bullet2 in bullets2:
        pygame.draw.rect(screen, "white", bullet2)
        bullet2.x -= 5

class Ship(pygame.sprite.Sprite):
    def __init__(self, i, x, y, angle):
        super().__init__()
        self.image = i
        self.image = pygame.transform.scale(self.image, (90, 60))
        self.image = pygame.transform.rotate(self.image, angle)
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y

ship1 = Ship(yellow_ship, WIDTH//6, HEIGHT//2 - 50, 90)
ship2 = Ship(red_ship, (WIDTH//6) * 5, HEIGHT//2 - 50, 270)
sprite_group = pygame.sprite.Group()
sprite_group.add(ship1, ship2)

play = True

while play == True:
    ship1_health = 10
    ship2_health = 10

    screen.blit(space_bg, (0, 0))
    sprite_group.draw(screen)
    pygame.draw.line(screen, "black", (WIDTH//2, HEIGHT), (WIDTH//2, 0), 20)

    font1 = pygame.font.SysFont("claibri", int(WIDTH/20))
    text1 = font1.render(f"Health: {ship1_health}", True, "white")
    screen.blit(text1, (WIDTH//20, HEIGHT//20))

    font2 = pygame.font.SysFont("claibri", int(WIDTH//20))
    text2 = font2.render(f"Health: {ship2_health}", True, "white")
    screen.blit(text1, ((WIDTH//20) * 15.5, HEIGHT//20))

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            play = False
        if event.type == pygame.KEYDOWN:      
            if event.key == pygame.K_SPACE:
                  bullet1 = pygame.Rect(ship1.rect.x + 65, ship1.rect.y + 42, 10, 5)
                  bullets1.append(bullet1)
                  
        if event.type == pygame.MOUSEBUTTONDOWN:
              bullet2 = pygame.Rect(ship2.rect.x - 15, ship2.rect.y + 43, 10, 5)
              bullets2.append(bullet2)

    shoot1()
    shoot2()

    hold = pygame.key.get_pressed()
    if hold[pygame.K_w]:
        ship1.rect.y -= 2
    if hold[pygame.K_a]:
        ship1.rect.x -= 2
    if hold[pygame.K_s]:
        ship1.rect.y += 2
    if hold[pygame.K_d]:
        ship1.rect.x += 2

    if ship1.rect.x < 0:
        ship1.rect.x = 0
    if ship1.rect.x > WIDTH//2 - 70:
        ship1.rect.x = WIDTH//2 - 70
    if ship1.rect.y < 0:
        ship1.rect.y = 0
    if ship1.rect.y > HEIGHT - 90:
        ship1.rect.y = HEIGHT - 90

    if hold[pygame.K_UP]:
        ship2.rect.y -= 2
    if hold[pygame.K_LEFT]:
        ship2.rect.x -= 2
    if hold[pygame.K_DOWN]:
        ship2.rect.y += 2
    if hold[pygame.K_RIGHT]:
        ship2.rect.x += 2

    if ship2.rect.x > WIDTH - 65:
        ship2.rect.x = WIDTH - 65
    if ship2.rect.x < WIDTH//2 + 10:
        ship2.rect.x = WIDTH//2 + 10
    if ship2.rect.y < 0:
        ship2.rect.y = 0
    if ship2.rect.y > HEIGHT - 90:
        ship2.rect.y = HEIGHT - 90
    
    pygame.display.update()